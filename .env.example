# Turso (required on Vercel for persistent live data)
# Create a free DB at https://turso.tech then paste values here / in Vercel env settings.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Separate database for the "Try the demo" button (same tables, sample data only).
# Must NOT point at the live database. Locally it falls back to server/data/student-crm-demo.db.
DEMO_TURSO_DATABASE_URL=
DEMO_TURSO_AUTH_TOKEN=

# Required on Vercel. Signs login tokens: use a long random value, e.g. `openssl rand -base64 48`.
AUTH_SECRET=
# Sets the admin account's password on startup (creates the account if missing).
ADMIN_PASSWORD=
